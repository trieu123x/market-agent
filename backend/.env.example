DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/market_agent_db
REDIS_URL=redis://localhost:6380/0
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# redis | memory (memory = chạy task ngay trong process API, không cần Redis/worker)
TASK_BROKER=redis
# auto | openai | hash (hash = embedding giả lập offline, chỉ dùng cho dev/test)
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=text-embedding-3-small
UPLOAD_DIR=storage/uploads
