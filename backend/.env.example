DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/market_agent_db
REDIS_URL=redis://localhost:6380/0
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# redis | memory (memory = chạy task ngay trong process API, không cần Redis/worker)
TASK_BROKER=redis
# Embedding Gemini (dùng GOOGLE_API_KEY)
EMBEDDING_MODEL=gemini-embedding-001
# Cross-Encoder rerank (tải model từ HuggingFace ở lần chạy đầu; false = giữ thứ tự RRF)
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# Gemini phân tích ảnh người dùng đính kèm khi chat
VISION_MODEL=gemini-2.5-flash
UPLOAD_DIR=storage/uploads
# redis | memory (memory = đếm trong process, chỉ cho dev/test)
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_PER_MINUTE=30
# Origin frontend được phép gọi API (JSON list)
CORS_ORIGINS=["http://localhost:3010"]
